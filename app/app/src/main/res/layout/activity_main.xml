<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/ph_bg"
  android:padding="16dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="20dp">

    <!-- header: always visible -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">
      <View
        android:id="@+id/dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:background="@color/ph_dim" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
          android:id="@+id/status"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="not paired"
          android:textColor="@color/ph_text"
          android:textSize="16sp"
          android:textStyle="bold" />
        <TextView
          android:id="@+id/identity"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="@color/ph_muted"
          android:textSize="13sp" />
      </LinearLayout>
    </LinearLayout>

    <!-- tabs -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:layout_marginTop="16dp">
      <Button
        android:id="@+id/tabStatus"
        style="@style/Widget.Phone.TabButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Status" />
      <Button
        android:id="@+id/tabShell"
        style="@style/Widget.Phone.TabButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Shell" />
      <Button
        android:id="@+id/tabSettings"
        style="@style/Widget.Phone.TabButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Settings" />
    </LinearLayout>

    <!-- TAB: status = setup first, agent loop after -->
    <LinearLayout
      android:id="@+id/tabStatusBody"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <LinearLayout
        android:id="@+id/setupBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
          style="@style/Section"
          android:text="setup" />
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Connect your agent"
          android:textColor="@color/ph_text"
          android:textSize="18sp"
          android:textStyle="bold" />
        <TextView
          android:id="@+id/setupStatus"
          style="@style/RowDesc"
          android:text="This screen checks each step as it happens." />
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal">
          <Button
            android:id="@+id/tabAsk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ask your agent" />
          <Button
            android:id="@+id/tabDiy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Do it yourself" />
        </LinearLayout>
        <LinearLayout
          android:id="@+id/askBox"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">
          <TextView
            style="@style/RowTitle"
            android:text="1 · Paste this into your agent" />
          <TextView
            android:id="@+id/agentPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pair my phone companion app: 1) call phone.doctor to find my relay's public URL, 2) call phone.pair to mint a code, 3) reply with exactly one tappable link and no other text: phone://pair?code=CODE&amp;relay=URL"
            android:textColor="@color/ph_text"
            android:textSize="13sp"
            android:background="@color/ph_bg_soft"
            android:padding="12dp" />
          <Button
            android:id="@+id/copyPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_primary"
            android:textColor="#FFFFFF"
            android:text="Copy" />
          <TextView
            style="@style/RowDesc"
            android:text="2 · Tap the link your agent replies with. 3 · Ask it: what's my battery?" />
        </LinearLayout>
        <LinearLayout
          android:id="@+id/diyBox"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:visibility="gone">
          <TextView
            style="@style/RowTitle"
            android:text="1 · Relay + code" />
          <TextView
            style="@style/RowDesc"
            android:text="The relay address, plus the code the desktop minted (MCP phone.pair)." />
          <EditText
            android:id="@+id/relayIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://….opentunnel.xyz or http://laptop-ip:19877"
            android:textColor="@color/ph_text"
            android:textColorHint="@color/ph_dim"
            android:singleLine="true"
            android:inputType="textUri" />
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
              android:id="@+id/codeIn"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:hint="XXXXXXXX"
              android:textColor="@color/ph_text"
              android:textColorHint="@color/ph_dim"
              android:singleLine="true"
              android:inputType="textCapCharacters" />
            <Button
              android:id="@+id/pairBtn"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:background="@drawable/btn_primary"
              android:textColor="#FFFFFF"
              android:text="Pair" />
          </LinearLayout>
          <TextView
            style="@style/RowDesc"
            android:text="2 · Ask your agent: what's my battery? The answer proves the loop." />
        </LinearLayout>
      </LinearLayout>

      <LinearLayout
        android:id="@+id/statusBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
          style="@style/Section"
          android:text="this phone" />
        <TextView
          style="@style/RowTitle"
          android:text="Name for agents" />
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal">
          <EditText
            android:id="@+id/nameIn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ph_text"
            android:singleLine="true" />
          <Button
            android:id="@+id/saveName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save" />
        </LinearLayout>
        <TextView
          style="@style/Section"
          android:text="agent jobs" />
        <TextView
          style="@style/RowTitle"
          android:text="Last job" />
        <TextView
          android:id="@+id/lastJob"
          style="@style/RowDesc"
          android:text="no jobs yet" />
      </LinearLayout>
    </LinearLayout>

    <!-- TAB: shell -->
    <LinearLayout
      android:id="@+id/tabShellBody"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:visibility="gone">
      <TextView
        style="@style/Section"
        android:text="shell" />
      <TextView
        style="@style/RowTitle"
        android:text="Shell (ADB)" />
      <TextView
        style="@style/RowDesc"
        android:text="Embedded ADB server, paired to this phone's own wireless debugging. Shell-UID commands, no second app." />
      <TextView
        android:id="@+id/shellStatus"
        style="@style/RowDesc"
        android:text="checking…" />
      <Button
        android:id="@+id/shellSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set up shell" />
    </LinearLayout>

    <!-- TAB: settings -->
    <LinearLayout
      android:id="@+id/tabSettingsBody"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:visibility="gone">
      <TextView
        style="@style/Section"
        android:text="relay" />
      <TextView
        android:id="@+id/advRelay"
        style="@style/RowDesc"
        android:text="—" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText
          android:id="@+id/relayEdit"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:hint="https://… or http://laptop-ip"
          android:textColor="@color/ph_text"
          android:textColorHint="@color/ph_dim"
          android:singleLine="true"
          android:inputType="textUri" />
        <Button
          android:id="@+id/relaySave"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/btn_primary"
          android:textColor="#FFFFFF"
          android:text="Use" />
      </LinearLayout>
      <TextView
        style="@style/RowTitle"
        android:text="Device" />
      <TextView
        android:id="@+id/advDevice"
        style="@style/RowDesc"
        android:text="—" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
          android:id="@+id/unpairBtn"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Unpair" />
        <Button
          android:id="@+id/forgetBtn"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Forget everything" />
      </LinearLayout>
      <TextView
        style="@style/Section"
        android:text="background" />
      <TextView
        style="@style/RowDesc"
        android:text="Keep the link alive with the screen off. One system prompt." />
      <TextView
        android:id="@+id/bgStatus"
        style="@style/RowDesc"
        android:text="checking…" />
      <Button
        android:id="@+id/bgBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Allow background" />
      <TextView
        style="@style/Section"
        android:text="auto-approve" />
      <TextView
        style="@style/RowDesc"
        android:text="Exact-match only, read-only recon. Nothing else ever auto-runs." />
      <TextView
        android:id="@+id/autoList"
        style="@style/RowDesc"
        android:text="date · uname -a · uptime · getprop ro.build.version.release · getprop ro.product.model · getprop ro.build.version.sdk · cat /proc/version"
        android:typeface="monospace"
        android:textSize="12sp" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
          android:id="@+id/autoStatus"
          style="@style/RowDesc"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="checking…" />
        <com.google.android.material.switchmaterial.SwitchMaterial
          android:id="@+id/autoSwitch"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>
      <TextView
        style="@style/Section"
        android:text="updates" />
      <TextView
        android:id="@+id/buildInfo"
        style="@style/RowDesc"
        android:text="—" />
      <TextView
        android:id="@+id/updateStatus"
        style="@style/RowDesc"
        android:text="checking…" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
          android:id="@+id/selfUpdateStatus"
          style="@style/RowDesc"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="checking…" />
        <com.google.android.material.switchmaterial.SwitchMaterial
          android:id="@+id/selfUpdateSwitch"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>
      <ProgressBar
        android:id="@+id/updateProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:visibility="gone" />
      <Button
        android:id="@+id/updateBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_primary"
        android:textColor="#FFFFFF"
        android:text="Check update" />
      <TextView
        style="@style/Section"
        android:text="log" />
      <TextView
        android:id="@+id/logView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ph_muted"
        android:textSize="12sp"
        android:typeface="monospace" />
    </LinearLayout>

  </LinearLayout>
</ScrollView>
