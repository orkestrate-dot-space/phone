<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Section">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">20dp</item>
    <item name="android:textColor">@color/ph_muted</item>
    <item name="android:textSize">12sp</item>
  </style>
  <style name="RowTitle">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">8dp</item>
    <item name="android:textColor">@color/ph_text</item>
    <item name="android:textSize">14sp</item>
    <item name="android:fontFamily">@font/inter_family</item>
    <item name="android:textStyle">bold</item>
  </style>
  <style name="RowDesc">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textColor">@color/ph_muted</item>
    <item name="android:textSize">13sp</item>
  </style>
  <!-- Machine/sensor text: IDs, URLs, job ids — matches the official app's
       D025f2bbe3d44cb9 / 420ms card pattern. -->
  <style name="MonoValue">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textColor">@color/ph_text</item>
    <item name="android:textSize">13sp</item>
    <item name="android:fontFamily">@font/plex_mono_family</item>
  </style>
  <style name="MonoValueMuted" parent="MonoValue">
    <item name="android:textColor">@color/ph_muted</item>
    <item name="android:textSize">12sp</item>
  </style>
  <style name="Widget.Phone.TabButton" parent="Widget.Material3.Button.TextButton">
    <item name="android:textColor">@color/ph_muted</item>
    <item name="android:fontFamily">@font/inter_family</item>
  </style>
  <!-- Settings row: icon + title/desc, tappable, like the official app's
       Appearance / Sessions / Voice rows. -->
  <style name="SettingsRow">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:orientation">horizontal</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:paddingTop">14dp</item>
    <item name="android:paddingBottom">14dp</item>
    <item name="android:background">?android:attr/selectableItemBackground</item>
  </style>
</resources>
